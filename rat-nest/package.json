{
  "name": "@p-w-g/ratnest",
  "version": "0.1.0",
  "description": "npm distribution wrapper for the rat CLI (downloads the prebuilt Rust binary for your platform)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-w-g/rats.git",
    "directory": "rat-nest"
  },
  "bin": {
    "rat": "./bin/rat.js"
  },
  "files": [
    "bin",
    "src",
    "scripts"
  ],
  "scripts": {
    "postinstall": "node ./scripts/postinstall.js",
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
